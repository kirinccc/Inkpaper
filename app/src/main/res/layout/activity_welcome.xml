<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F3">

    <LinearLayout
        android:id="@+id/tv_legado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/iv_book"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/welcome"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_inkpaper_launcher_fg" />

        <View
            android:id="@+id/vw_title_line"
            android:layout_width="24dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="14dp"
            android:background="#1B1B18" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:text="InkPaper"
            android:textColor="#1B1B18"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tv_gzh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.12"
            android:text="素纸墨韵"
            android:textColor="#8E8C84"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
